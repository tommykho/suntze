---
import '../styles/global.css';
import InkDefs from '../components/InkDefs.astro';
import Seal from '../components/Seal.astro';
import { SITE } from '../site.config.js';

const { title, description = SITE.description, bodyClass = '' } = Astro.props;
const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.tagline}`;
const path = Astro.url.pathname;
const canonical = new URL(path, SITE.url).href;
const nav = [
  { href: '/chapters/1/', label: 'The Book', match: '/chapters' },
  { href: '/tactics/', label: 'Tactics', match: '/tactics' },
  { href: '/field/', label: 'Field Challenge', match: '/field' },
  { href: '/community/', label: 'Community', match: '/community' },
  { href: '/about/', label: 'About', match: '/about' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#100e0b" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=EB+Garamond:ital,wght@0,400;0,500;1,400&family=Inter:wght@400;500;600&family=LXGW+WenKai+TC:wght@400;700&family=Noto+Serif+TC:wght@400;600;900&display=swap"
    />
    <script is:inline src="/boot.js"></script>
  </head>
  <body class={bodyClass}>
    <InkDefs />
    <a class="sr-only" href="#main">Skip to content</a>
    <header class="site-header" data-header>
      <nav class="wrap nav" aria-label="Primary">
        <a class="brand" href="/" aria-label={`${SITE.name} — home`}>
          <Seal text="兵法" size="sm" vertical />
          <span class="brand-name">Sun Tzu<small>Modern Field Manual</small></span>
        </a>
        <ul class="nav-links" id="nav-links">
          {nav.map((n) => (
            <li><a href={n.href} aria-current={path.startsWith(n.match) ? 'page' : undefined}>{n.label}</a></li>
          ))}
        </ul>
        <a class="btn btn--seal btn--sm" href="/field/">Ask the General</a>
        <button class="nav-toggle" type="button" aria-controls="nav-links" aria-expanded="false" data-nav-toggle>
          <span class="sr-only">Menu</span>
          <svg width="18" height="14" viewBox="0 0 18 14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M1 2h16M1 7h16M1 12h11" /></svg>
        </button>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <a class="brand" href="/" style="margin-bottom:14px">
              <Seal text="兵法" size="sm" vertical />
              <span class="brand-name" style="color:var(--paper)">Sun Tzu<small>Modern Field Manual</small></span>
            </a>
            <p style="max-width:44ch">
              Win without fighting. Thirteen chapters of the oldest strategy text in the world, turned into calm, practical moves for modern work and life.
            </p>
          </div>
          <div>
            <h4>Explore</h4>
            <ul>
              <li><a href="/chapters/1/">The thirteen chapters</a></li>
              <li><a href="/tactics/">Tactic library</a></li>
              <li><a href="/field/">Field Challenge (AI)</a></li>
              <li><a href="/community/">Community field reports</a></li>
            </ul>
          </div>
          <div>
            <h4>Project</h4>
            <ul>
              <li><a href="/about/">Sources &amp; method</a></li>
              <li><a href="/about/#privacy">Privacy &amp; your API keys</a></li>
              <li><a href={SITE.repo} rel="noopener">Source code</a></li>
            </ul>
          </div>
        </div>
        <p class="footer-legal">
          Text: Lionel Giles translation (1910) and the original 孫子兵法, both public domain (Project Gutenberg #17405, #23864).
          Tactics are general guidance, not legal, HR, medical or financial advice. Use them ethically.
        </p>
      </div>
    </footer>
    <script src="../scripts/motion.js"></script>
  </body>
</html>
