---
// Chapter pagination: prev / I…XIII (+ optional "All") / next.
// mode "book": links to chapter pages. mode "tactics": links to the tactic library filtered by chapter
// (the library page upgrades these links to instant client-side filtering).
import { chapters } from '../lib/content.js';
import { u } from '../lib/url.js';

const { current = 0, mode = 'book', withAll = false, label = 'Chapters', class: cls = '' } = Astro.props;
const href = (n) => (mode === 'book' ? u(`/chapters/${n}/`) : n ? u(`/tactics/?ch=${n}`) : u('/tactics/'));
const prev = current > 1 ? current - 1 : null;
const next = current && current < chapters.length ? current + 1 : null;
---
<nav class={`pager ${cls}`} aria-label={label} data-pager={mode}>
  {prev ? <a class="pg-step" href={href(prev)} data-pg={prev} aria-label={`Previous: chapter ${chapters[prev - 1].roman}`}>←</a> : <span class="pg-step is-off" aria-hidden="true">←</span>}
  <ol class="pg-list">
    {withAll && (
      <li><a class={`pg-item pg-all ${current === 0 ? 'is-on' : ''}`} href={href(0)} data-pg="" aria-current={current === 0 ? 'page' : undefined}>All</a></li>
    )}
    {chapters.map((c) => (
      <li>
        <a class={`pg-item ${c.n === current ? 'is-on' : ''}`} href={href(c.n)} data-pg={c.n} title={`${c.roman}. ${c.title_en} · ${c.title_zh}`} aria-current={c.n === current ? 'page' : undefined}>
          <span class="pg-roman">{c.roman}</span>
          <span class="pg-zh" lang="zh-Hant">{c.title_zh}</span>
        </a>
      </li>
    ))}
  </ol>
  {next ? <a class="pg-step" href={href(next)} data-pg={next} aria-label={`Next: chapter ${chapters[next - 1].roman}`}>→</a> : <span class="pg-step is-off" aria-hidden="true">→</span>}
</nav>

<style>
  .pager { display: flex; align-items: center; gap: 8px; }
  .pg-list { list-style: none; margin: 0; padding: 4px 2px; display: flex; gap: 6px; overflow-x: auto; scrollbar-width: thin; scroll-snap-type: x proximity; flex: 1; }
  .pg-list li { scroll-snap-align: center; }
  .pg-item { display: grid; justify-items: center; gap: 2px; min-width: 52px; padding: 7px 8px 6px; border-radius: 10px; border: 1px solid var(--line); text-decoration: none; color: var(--paper-2); background: rgba(239, 229, 207, 0.02); transition: border-color 0.25s, background 0.25s, color 0.25s, transform 0.25s var(--ease); }
  .pg-item:hover { border-color: var(--paper-3); color: var(--paper); transform: translateY(-2px); }
  .pg-item.is-on { background: var(--seal); border-color: var(--seal); color: var(--paper); box-shadow: 0 8px 20px -10px var(--seal-glow); }
  .pg-roman { font: 600 0.78rem var(--f-ui); letter-spacing: 0.06em; }
  .pg-zh { font: 500 0.72rem var(--f-zh); opacity: 0.8; letter-spacing: 0.04em; }
  .pg-all { align-content: center; font: 600 0.78rem var(--f-ui); min-height: 46px; }
  .pg-step { flex: none; width: 40px; height: 40px; display: grid; place-items: center; border-radius: 50%; border: 1px solid var(--line-2); text-decoration: none; color: var(--paper); font: 500 1rem var(--f-ui); transition: background 0.25s, border-color 0.25s; }
  .pg-step:hover { background: var(--paper); color: var(--ink-1); }
  .pg-step.is-off { opacity: 0.25; pointer-events: none; }
</style>
