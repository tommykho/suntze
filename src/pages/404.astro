---
import Base from '../layouts/Base.astro';
import Seal from '../components/Seal.astro';
---
<Base title="Lost ground">
  <section class="wrap" style="min-height:80vh;display:grid;place-items:center;text-align:center;padding-top:120px">
    <div>
      <Seal text="迷" size="lg" style="margin:0 auto 28px" />
      <h1>Lost ground.</h1>
      <p class="lede" style="margin-inline:auto">“On dispersive ground, therefore, fight not.” <a href="/chapters/11/#v11-11">11.11</a><br />This page does not exist. Regroup and choose your route.</p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:24px">
        <a class="btn btn--seal" href="/">Home</a>
        <a class="btn" href="/tactics/">Tactics</a>
        <a class="btn" href="/field/">Field Challenge</a>
      </div>
    </div>
  </section>
</Base>
