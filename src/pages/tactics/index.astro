---
import { u } from '../../lib/url.js';
import Base from '../../layouts/Base.astro';
import TacticCard from '../../components/TacticCard.astro';
import ChapterPager from '../../components/ChapterPager.astro';
import { tactics, chapters, DOMAINS } from '../../lib/content.js';
---
<Base title="Tactic library" description={`${tactics.length} practical Sun Tzu tactics for work, career, business, family and self — each with steps, a ready-to-send script and a backfire check.`}>
  <header class="lib-hero wrap">
    <p class="eyebrow" data-reveal>Tactic library · 兵法實戰</p>
    <h1 data-reveal>{tactics.length} moves for modern battles.</h1>
    <p class="lede" data-reveal>Each tactic is anchored to a verse, broken into steps, paired with a message you can send today, and ends with an honest backfire check.</p>
  </header>

  <section class="wrap lib">
    <div class="filters panel" data-filters>
      <div class="pager-row">
        <span class="label">Chapter</span>
        <ChapterPager current={0} mode="tactics" withAll label="Filter tactics by chapter" />
      </div>
      <div class="field" style="flex:1 1 260px">
        <label for="q">Search</label>
        <input id="q" class="input" type="search" placeholder="manager, deadline, landlord, salary…" autocomplete="off" data-q />
      </div>
      <div class="domains" role="group" aria-label="Domain">
        <button class="chip" type="button" aria-pressed="true" data-domain="">All</button>
        {Object.entries(DOMAINS).map(([k, d]) => <button class="chip" type="button" aria-pressed="false" data-domain={k}>{d.label} <span class="zh">{d.zh}</span></button>)}
      </div>
    </div>
    <div class="ch-banner" hidden data-ch-banner>
      {chapters.map((c) => (
        <div hidden data-ch-info={c.n}>
          <span class="eyebrow">Chapter {c.roman} · <span class="zh">{c.title_zh}</span></span>
          <h2>{c.title_en}</h2>
          <p>{c.essence} <a href={u(`/chapters/${c.n}/`)}>Read the chapter →</a></p>
        </div>
      ))}
    </div>
    <p class="hint" aria-live="polite" data-count>{tactics.length} tactics</p>
    <div class="grid" data-grid>
      {tactics.map((t) => <TacticCard t={t} />)}
    </div>
    <p class="empty" hidden data-empty>No tactic matches yet. <a href={u('/ask/')}>Ask the General</a> and describe your situation in your own words.</p>
  </section>
</Base>

<script>
  const cards = [...document.querySelectorAll('[data-grid] > .tactic-card')];
  const q = document.querySelector('[data-q]');
  const count = document.querySelector('[data-count]');
  const empty = document.querySelector('[data-empty]');
  const pager = document.querySelector('[data-pager="tactics"]');
  const banner = document.querySelector('[data-ch-banner]');
  const MAX = 13;
  const params = new URLSearchParams(location.search);
  let domain = params.get('domain') || '';
  let chapter = /^\d+$/.test(params.get('ch') || '') ? params.get('ch') : '';
  if (params.get('q')) q.value = params.get('q');

  const syncPager = () => {
    const n = Number(chapter) || 0;
    pager.querySelectorAll('.pg-item').forEach((a) => {
      const on = (a.dataset.pg || '') === chapter;
      a.classList.toggle('is-on', on);
      on ? a.setAttribute('aria-current', 'page') : a.removeAttribute('aria-current');
      if (on) a.scrollIntoView({ block: 'nearest', inline: 'center' });
    });
    const [prev, next] = pager.querySelectorAll('.pg-step');
    const setStep = (el, target) => {
      el.classList.toggle('is-off', !target);
      el.dataset.pg = target ? String(target) : '';
    };
    setStep(prev, n > 1 ? n - 1 : null);
    setStep(next, n && n < MAX ? n + 1 : n === 0 ? 1 : null);
    banner.hidden = !chapter;
    banner.querySelectorAll('[data-ch-info]').forEach((d) => (d.hidden = d.dataset.chInfo !== chapter));
  };

  const run = () => {
    const terms = q.value.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const c of cards) {
      const ok = (!domain || c.dataset.domain === domain) && (!chapter || c.dataset.chapter === chapter) && terms.every((t) => c.dataset.text.includes(t));
      c.hidden = !ok;
      if (ok) { shown++; c.style.opacity = 1; c.style.transform = 'none'; }
    }
    count.textContent = `${shown} tactic${shown === 1 ? '' : 's'}${chapter ? ` in chapter ${chapter}` : ''}`;
    empty.hidden = shown > 0;
    document.querySelectorAll('button[data-domain]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.domain === domain)));
    syncPager();
    window.dispatchEvent(new Event('resize'));
  };

  const setUrl = () => {
    const p = new URLSearchParams();
    if (chapter) p.set('ch', chapter);
    if (domain) p.set('domain', domain);
    if (q.value.trim()) p.set('q', q.value.trim());
    history.replaceState(null, '', `${location.pathname}${p.toString() ? `?${p}` : ''}`);
  };

  // Pager links work without JS; with JS they filter instantly.
  pager.addEventListener('click', (e) => {
    const a = e.target.closest('[data-pg]');
    if (!a || a.classList.contains('is-off')) return;
    e.preventDefault();
    chapter = a.dataset.pg || '';
    run();
    setUrl();
  });
  q.addEventListener('input', () => { run(); setUrl(); });
  document.querySelectorAll('button[data-domain]').forEach((b) => b.addEventListener('click', () => { domain = b.dataset.domain; run(); setUrl(); }));
  run();
</script>

<style>
  .lib-hero { padding: 140px 0 32px; }
  .filters { display: flex; flex-wrap: wrap; gap: 16px; align-items: end; margin-bottom: 14px; position: relative; z-index: 2; }
  .pager-row { flex-basis: 100%; display: grid; gap: 8px; min-width: 0; }
  .domains { display: flex; flex-wrap: wrap; gap: 6px; flex-basis: 100%; }
  .lib { padding-bottom: 100px; }
  .lib .grid { margin-top: 18px; }
  .ch-banner { margin: 22px 0 6px; padding: 18px 22px; border-left: 2px solid var(--seal); background: rgba(239, 229, 207, 0.03); border-radius: 0 12px 12px 0; }
  .ch-banner h2 { font-size: clamp(1.6rem, 1.6vw + 1rem, 2.2rem); margin: 4px 0 6px; }
  .ch-banner p { margin: 0; color: var(--paper-2); }
  .ch-banner a { color: var(--seal-hi); text-decoration: none; font: 600 0.8rem var(--f-ui); margin-left: 6px; }
  .empty { padding: 40px 0; color: var(--paper-2); }
</style>
