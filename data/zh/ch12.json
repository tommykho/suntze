{
  "n": 12,
  "segments": [
    {
      "id": "12.1",
      "zh": "孫子曰：凡火攻有五：一曰火人，二曰火積，三曰火輜，四曰火庫，五曰火隊。"
    },
    {
      "id": "12.2",
      "zh": "行火必有因，因必素具。"
    },
    {
      "id": "12.3",
      "zh": "發火有時，起火有日。"
    },
    {
      "id": "12.4",
      "zh": "時者，天之燥也。日者，月在箕、壁、翼、軫也。凡此四宿者，風起之日也。"
    },
    {
      "id": "12.5",
      "zh": "凡火攻，必因五火之變而應之："
    },
    {
      "id": "12.6",
      "zh": "火發於內，則早應之於外；"
    },
    {
      "id": "12.7",
      "zh": "火發而其兵靜者，待而勿攻，"
    },
    {
      "id": "12.8",
      "zh": "極其火力，可從而從之，不可從則上。"
    },
    {
      "id": "12.9",
      "zh": "火可發於外，無待於內，以時發之，"
    },
    {
      "id": "12.10",
      "zh": "火發上風，無攻下風，"
    },
    {
      "id": "12.11",
      "zh": "晝風久，夜風止。"
    },
    {
      "id": "12.12",
      "zh": "凡軍必知五火之變，以數守之。"
    },
    {
      "id": "12.13",
      "zh": "故以火佐攻者明，以水佐攻者強。"
    },
    {
      "id": "12.14",
      "zh": "水可以絕，不可以奪。"
    },
    {
      "id": "12.15",
      "zh": "夫戰勝攻取而不惰其功者凶，命曰“費留”。"
    },
    {
      "id": "12.16",
      "zh": "故曰：明主慮之，良將惰之，"
    },
    {
      "id": "12.17",
      "zh": "非利不動，非得不用，非危不戰。"
    },
    {
      "id": "12.18",
      "zh": "主不可以怒而興師，將不可以慍而攻戰。"
    },
    {
      "id": "12.19",
      "zh": "合於利而動，不合於利而上。"
    },
    {
      "id": "12.20",
      "zh": "怒可以複喜，慍可以複說，"
    },
    {
      "id": "12.21",
      "zh": "亡國不可以複存，死者不可以複生。"
    },
    {
      "id": "12.22",
      "zh": "故明主慎之，良將警之。此安國全軍之道也。"
    }
  ]
}
