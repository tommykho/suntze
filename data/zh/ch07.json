{
  "n": 7,
  "segments": [
    {
      "id": "7.1",
      "zh": "孫子曰： 凡用兵之法，將受命於君，"
    },
    {
      "id": "7.2",
      "zh": "合軍聚眾，交和而舍，"
    },
    {
      "id": "7.3",
      "zh": "莫難於軍爭。軍爭之難者，以迂為直，以患為利。"
    },
    {
      "id": "7.4",
      "zh": "故迂其途，而誘之以利，後人發，先人至，此知迂直之計者也。"
    },
    {
      "id": "7.5",
      "zh": "軍爭為利，軍爭為危。"
    },
    {
      "id": "7.6",
      "zh": "舉軍而爭利則不及，委軍而爭利則輜重捐。"
    },
    {
      "id": "7.7",
      "zh": "是故捲甲而趨，日夜不處，倍道兼行，百裡而爭利，則擒三將軍，"
    },
    {
      "id": "7.8",
      "zh": "勁者先，疲者後，其法十一而至；"
    },
    {
      "id": "7.9",
      "zh": "五十裏而爭利，則蹶上將軍，其法半至；"
    },
    {
      "id": "7.10",
      "zh": "三十裏而爭利，則三分之二至。"
    },
    {
      "id": "7.11",
      "zh": "是故軍無輜重則亡，無糧食則亡，無委積則亡。"
    },
    {
      "id": "7.12",
      "zh": "故不知諸侯之謀者，不能豫交；"
    },
    {
      "id": "7.13",
      "zh": "不知山林、險阻、沮澤之形者，不能行軍；"
    },
    {
      "id": "7.14",
      "zh": "不用鄉導者，不能得地利。"
    },
    {
      "id": "7.15",
      "zh": "故兵以詐立，"
    },
    {
      "id": "7.16",
      "zh": "以利動，以分和為變者也。"
    },
    {
      "id": "7.17",
      "zh": "故其疾如風，其徐如林，"
    },
    {
      "id": "7.18",
      "zh": "侵掠如火，不動如山，"
    },
    {
      "id": "7.19",
      "zh": "難知如陰，動如雷震。"
    },
    {
      "id": "7.20",
      "zh": "掠鄉分眾，廓地分利，"
    },
    {
      "id": "7.21",
      "zh": "懸權而動。"
    },
    {
      "id": "7.22",
      "zh": "先知迂直之計者勝，此軍爭之法也。"
    },
    {
      "id": "7.23",
      "zh": "《軍政》曰：“言不相聞，故為之金鼓；視不相見，故為之旌旗。”"
    },
    {
      "id": "7.24",
      "zh": "夫金鼓旌旗者，所以一民之耳目也。"
    },
    {
      "id": "7.25",
      "zh": "民既專一，則勇者不得獨進，怯者不得獨退，此用眾之法也。"
    },
    {
      "id": "7.26",
      "zh": "故夜戰多金鼓，晝戰多旌旗，所以變人之耳目也。"
    },
    {
      "id": "7.27",
      "zh": "三軍可奪氣，將軍可奪心。"
    },
    {
      "id": "7.28",
      "zh": "是故朝氣銳，晝氣惰，暮氣歸。"
    },
    {
      "id": "7.29",
      "zh": "善用兵者，避其銳氣，擊其惰歸，此治氣者也。"
    },
    {
      "id": "7.30",
      "zh": "以治待亂，以靜待嘩，此治心者也。"
    },
    {
      "id": "7.31",
      "zh": "以近待遠，以佚待勞，以飽待饑，此治力者也。"
    },
    {
      "id": "7.32",
      "zh": "無邀正正之旗，無擊堂堂之陳，此治變者也。"
    },
    {
      "id": "7.33",
      "zh": "故用兵之法，高陵勿向，背丘勿逆，"
    },
    {
      "id": "7.34",
      "zh": "佯北勿從，銳卒勿攻，"
    },
    {
      "id": "7.35",
      "zh": "餌兵勿食，歸師勿遏，"
    },
    {
      "id": "7.36",
      "zh": "圍師遺闕，窮寇勿迫，"
    },
    {
      "id": "7.37",
      "zh": "此用兵之法也。"
    }
  ]
}
