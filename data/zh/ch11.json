{
  "n": 11,
  "segments": [
    {
      "id": "11.1",
      "zh": "孫子曰：用兵之法，有散地，有輕地，有爭地，有交地，有衢地，有重地，有泛地，有圍地，有死地。"
    },
    {
      "id": "11.2",
      "zh": "諸侯自戰其地者，為散地；"
    },
    {
      "id": "11.3",
      "zh": "入人之地不深者，為輕地；"
    },
    {
      "id": "11.4",
      "zh": "我得亦利，彼得亦利者，為爭地；"
    },
    {
      "id": "11.5",
      "zh": "我可以往，彼可以來者，為交地；"
    },
    {
      "id": "11.6",
      "zh": "諸侯之地三屬，先至而得天下眾者，為衢地；"
    },
    {
      "id": "11.7",
      "zh": "入人之地深，背城邑多者，為重地；"
    },
    {
      "id": "11.8",
      "zh": "山林、險阻、沮澤，凡難行之道者，為泛地；"
    },
    {
      "id": "11.9",
      "zh": "所由入者隘，所從歸者迂，彼寡可以擊吾之眾者，為圍地；"
    },
    {
      "id": "11.10",
      "zh": "疾戰則存，不疾戰則亡者，為死地。"
    },
    {
      "id": "11.11",
      "zh": "是故散地則無戰，輕地則無止，爭地則無攻，"
    },
    {
      "id": "11.12",
      "zh": "交地則無絕，衢地則合交，"
    },
    {
      "id": "11.13",
      "zh": "重地則掠，泛地則行，"
    },
    {
      "id": "11.14",
      "zh": "圍地則謀，死地則戰。"
    },
    {
      "id": "11.15",
      "zh": "古之善用兵者，能使敵人前後不相及，眾寡不相恃，貴賤不相救，上下不相收，卒離而不集，"
    },
    {
      "id": "11.16",
      "zh": "兵合而不齊。"
    },
    {
      "id": "11.17",
      "zh": "合於利而動，不合於利而止。"
    },
    {
      "id": "11.18",
      "zh": "敢問敵眾而整將來，待之若何曰：先奪其所愛則聽矣。"
    },
    {
      "id": "11.19",
      "zh": "兵之情主速，乘人之不及。由不虞之道，攻其所不戒也。"
    },
    {
      "id": "11.20",
      "zh": "凡為客之道，深入則專。"
    },
    {
      "id": "11.21",
      "zh": "主人不克，掠於饒野，三軍足食。"
    },
    {
      "id": "11.22",
      "zh": "謹養而勿勞，並氣積力，運兵計謀，為不可測。"
    },
    {
      "id": "11.23",
      "zh": "投之無所往，死且不北。"
    },
    {
      "id": "11.24",
      "zh": "死焉不得，士人盡力。兵士甚陷則不懼，無所往則固，深入則拘，不得已則鬥。"
    },
    {
      "id": "11.25",
      "zh": "是故其兵不修而戒，不求而得，不約而親，不令而信，"
    },
    {
      "id": "11.26",
      "zh": "禁祥去疑，至死無所之。"
    },
    {
      "id": "11.27",
      "zh": "吾士無餘財，非惡貨也；無餘命，非惡壽也。"
    },
    {
      "id": "11.28",
      "zh": "令發之日，士卒坐者涕沾襟，偃臥者涕交頤，投之無所往，諸、劌之勇也。"
    },
    {
      "id": "11.29",
      "zh": "故善用兵者，譬如率然。率然者，常山之蛇也。擊其首則尾至，擊其尾則首至，擊其中則首尾俱至。"
    },
    {
      "id": "11.30",
      "zh": "敢問兵可使如率然乎？曰可。夫吳人與越人相惡也，當其同舟而濟而遇風，其相救也如左右手。"
    },
    {
      "id": "11.31",
      "zh": "是故方馬埋輪，未足恃也；"
    },
    {
      "id": "11.32",
      "zh": "齊勇如一，政之道也；"
    },
    {
      "id": "11.33",
      "zh": "剛柔皆得，地之理也。"
    },
    {
      "id": "11.34",
      "zh": "故善用兵者，攜手若使一人，不得已也。"
    },
    {
      "id": "11.35",
      "zh": "將軍之事，靜以幽，正以治，"
    },
    {
      "id": "11.36",
      "zh": "能愚士卒之耳目，使之無知；"
    },
    {
      "id": "11.37",
      "zh": "易其事，革其謀，使人無識；易其居，迂其途，使民不得慮。"
    },
    {
      "id": "11.38",
      "zh": "帥與之期，如登高而去其梯；帥與之深入諸侯之地，而發其機。"
    },
    {
      "id": "11.39",
      "zh": "若驅群羊，驅而往，驅而來，莫知所之。"
    },
    {
      "id": "11.40",
      "zh": "聚三軍之眾，投之於險，此謂將軍之事也。"
    },
    {
      "id": "11.41",
      "zh": "九地之變，屈伸之力，人情之理，不可不察也。"
    },
    {
      "id": "11.42",
      "zh": "凡為客之道，深則專，淺則散。"
    },
    {
      "id": "11.43",
      "zh": "去國越境而師者，絕地也；四徹者，衢地也；"
    },
    {
      "id": "11.44",
      "zh": "入深者，重地也；入淺者，輕地也；"
    },
    {
      "id": "11.45",
      "zh": "背固前隘者，圍地也；無所往者，死地也。"
    },
    {
      "id": "11.46",
      "zh": "是故散地吾將一其志，輕地吾將使之屬，"
    },
    {
      "id": "11.47",
      "zh": "爭地吾將趨其後，"
    },
    {
      "id": "11.48",
      "zh": "交地吾將謹其守，交地吾將固其結，衢地吾將謹其恃，"
    },
    {
      "id": "11.49",
      "zh": "重地吾將繼其食，泛地吾將進其途，"
    },
    {
      "id": "11.50",
      "zh": "圍地吾將塞其闕，死地吾將示之以不活。"
    },
    {
      "id": "11.51",
      "zh": "故兵之情：圍則禦，不得已則鬥，過則從。"
    },
    {
      "id": "11.52",
      "zh": "是故不知諸侯之謀者，不能預交；不知山林、險阻、沮澤之形者，不能行軍；不用鄉導，不能得地利。"
    },
    {
      "id": "11.53",
      "zh": "四五者，一不知，非霸王之兵也。"
    },
    {
      "id": "11.54",
      "zh": "夫霸王之兵，伐大國，則其眾不得聚；威加於敵，則其交不得合。"
    },
    {
      "id": "11.55",
      "zh": "是故不爭天下之交，不養天下之權，信己之私，威加於敵，則其城可拔，其國可隳。"
    },
    {
      "id": "11.56",
      "zh": "施無法之賞，懸無政之令。犯三軍之眾，若使一人。"
    },
    {
      "id": "11.57",
      "zh": "犯之以事，勿告以言；犯之以害，勿告以利。"
    },
    {
      "id": "11.58",
      "zh": "投之亡地然後存，陷之死地然後生。"
    },
    {
      "id": "11.59",
      "zh": "夫眾陷於害，然後能為勝敗。"
    },
    {
      "id": "11.60",
      "zh": "故為兵之事，在順詳敵之意，"
    },
    {
      "id": "11.61",
      "zh": "並敵一向，千里殺將，"
    },
    {
      "id": "11.62",
      "zh": "是謂巧能成事。"
    },
    {
      "id": "11.63",
      "zh": "是故政舉之日，夷關折符，無通其使，"
    },
    {
      "id": "11.64",
      "zh": "厲於廊廟之上，以誅其事。"
    },
    {
      "id": "11.65",
      "zh": "敵人開闔，必亟入之，"
    },
    {
      "id": "11.66",
      "zh": "先其所愛，微與之期，"
    },
    {
      "id": "11.67",
      "zh": "踐墨隨敵，以決戰事。"
    },
    {
      "id": "11.68",
      "zh": "是故始如處女，敵人開戶；後如脫兔，敵不及拒。"
    }
  ]
}
