{
  "n": 9,
  "segments": [
    {
      "id": "9.1",
      "zh": "孫子曰：凡處軍相敵，絕山依穀，"
    },
    {
      "id": "9.2",
      "zh": "視生處高，戰隆無登，此處山之軍也。"
    },
    {
      "id": "9.3",
      "zh": "絕水必遠水，"
    },
    {
      "id": "9.4",
      "zh": "客絕水而來，勿迎之於水內，令半渡而擊之利，"
    },
    {
      "id": "9.5",
      "zh": "欲戰者，無附於水而迎客，"
    },
    {
      "id": "9.6",
      "zh": "視生處高，無迎水流，此處水上之軍也。"
    },
    {
      "id": "9.7",
      "zh": "絕斥澤，唯亟去無留，"
    },
    {
      "id": "9.8",
      "zh": "若交軍於斥澤之中，必依水草而背眾樹，此處斥澤之軍也。"
    },
    {
      "id": "9.9",
      "zh": "平陸處易，右背高，前死後生，此處平陸之軍也。"
    },
    {
      "id": "9.10",
      "zh": "凡此四軍之利，黃帝之所以勝四帝也。"
    },
    {
      "id": "9.11",
      "zh": "凡軍好高而惡下，貴陽而賤陰，"
    },
    {
      "id": "9.12",
      "zh": "養生而處實，軍無百疾，是謂必勝。"
    },
    {
      "id": "9.13",
      "zh": "丘陵堤防，必處其陽而右背之，此兵之利，地之助也。"
    },
    {
      "id": "9.14",
      "zh": "上雨水流至，欲涉者，待其定也。"
    },
    {
      "id": "9.15",
      "zh": "凡地有絕澗、天井、天牢、天羅、天陷、天隙，必亟去之，勿近也。"
    },
    {
      "id": "9.16",
      "zh": "吾遠之，敵近之；吾迎之，敵背之。"
    },
    {
      "id": "9.17",
      "zh": "軍旁有險阻、潢井、蒹葭、小林、蘙薈者，必謹覆索之，此伏姦之所處也。"
    },
    {
      "id": "9.18",
      "zh": "敵近而靜者，恃其險也；"
    },
    {
      "id": "9.19",
      "zh": "遠而挑戰者，欲人之進也；"
    },
    {
      "id": "9.20",
      "zh": "其所居易者，利也；"
    },
    {
      "id": "9.21",
      "zh": "眾樹動者，來也；眾草多障者，疑也；"
    },
    {
      "id": "9.22",
      "zh": "鳥起者，伏也；獸駭者，覆也；"
    },
    {
      "id": "9.23",
      "zh": "塵高而銳者，車來也；卑而廣者，徒來也；散而條達者，樵採也；少而往來者，營軍也；"
    },
    {
      "id": "9.24",
      "zh": "辭卑而備者，進也；辭強而進驅者，退也；"
    },
    {
      "id": "9.25",
      "zh": "輕車先出居其側者，陳也；"
    },
    {
      "id": "9.26",
      "zh": "無約而請和者，謀也；"
    },
    {
      "id": "9.27",
      "zh": "奔走而陳兵者，期也；"
    },
    {
      "id": "9.28",
      "zh": "半進半退者，誘也；"
    },
    {
      "id": "9.29",
      "zh": "杖而立者，饑也；"
    },
    {
      "id": "9.30",
      "zh": "汲而先飲者，渴也；"
    },
    {
      "id": "9.31",
      "zh": "見利而不進者，勞也；"
    },
    {
      "id": "9.32",
      "zh": "鳥集者，虛也；夜呼者，恐也；"
    },
    {
      "id": "9.33",
      "zh": "軍擾者，將不重也；旌旗動者，亂也；吏怒者，倦也；"
    },
    {
      "id": "9.34",
      "zh": "殺馬肉食者，軍無糧也；懸甀不返其舍者，窮寇也；"
    },
    {
      "id": "9.35",
      "zh": "諄諄翕翕，徐與人言者，失眾也；"
    },
    {
      "id": "9.36",
      "zh": "數賞者，窘也；數罰者，困也；"
    },
    {
      "id": "9.37",
      "zh": "先暴而後畏其眾者，不精之至也；"
    },
    {
      "id": "9.38",
      "zh": "來委謝者，欲休息也。"
    },
    {
      "id": "9.39",
      "zh": "兵怒而相迎，久而不合，又不相去，必謹察之。"
    },
    {
      "id": "9.40",
      "zh": "兵非貴益多也，惟無武進，足以並力料敵取人而已。"
    },
    {
      "id": "9.41",
      "zh": "夫惟無慮而易敵者，必擒於人。"
    },
    {
      "id": "9.42",
      "zh": "卒未親而罰之，則不服，不服則難用。卒已親附而罰不行，則不可用。"
    },
    {
      "id": "9.43",
      "zh": "故合之以文，齊之以武，是謂必取。"
    },
    {
      "id": "9.44",
      "zh": "令素行以教其民，則民服；令素不行以教其民，則民不服。"
    },
    {
      "id": "9.45",
      "zh": "令素行者，與眾相得也。"
    }
  ]
}
