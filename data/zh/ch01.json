{
  "n": 1,
  "segments": [
    {
      "id": "1.1",
      "zh": "孫子曰：兵者，國之大事，"
    },
    {
      "id": "1.2",
      "zh": "死生之地，存亡之道，不可不察也。"
    },
    {
      "id": "1.3",
      "zh": "故經之以五事，校之以計，而索其情："
    },
    {
      "id": "1.4",
      "zh": "一曰道，二曰天，三曰地，四曰將，五曰法。"
    },
    {
      "id": "1.5",
      "zh": "道者，令民與上同意，可與之死，可與之生，而不畏危也；"
    },
    {
      "id": "1.7",
      "zh": "天者，陰陽、寒暑、時制也；"
    },
    {
      "id": "1.8",
      "zh": "地者，遠近、險易、廣狹、死生也；"
    },
    {
      "id": "1.9",
      "zh": "將者，智、信、仁、勇、嚴也；"
    },
    {
      "id": "1.10",
      "zh": "法者，曲制、官道、主用也。"
    },
    {
      "id": "1.11",
      "zh": "凡此五者，將莫不聞，知之者勝，不知者不勝。"
    },
    {
      "id": "1.12",
      "zh": "故校之以計，而索其情，曰："
    },
    {
      "id": "1.13",
      "zh": "主孰有道？將孰有能？天地孰得？法令孰行？兵眾孰強？士卒孰練？賞罰孰明？"
    },
    {
      "id": "1.14",
      "zh": "吾以此知勝負矣。"
    },
    {
      "id": "1.15",
      "zh": "將聽吾計，用之必勝，留之；將不聽吾計，用之必敗，去之。"
    },
    {
      "id": "1.16",
      "zh": "計利以聽，乃為之勢，以佐其外。"
    },
    {
      "id": "1.17",
      "zh": "勢者，因利而制權也。"
    },
    {
      "id": "1.18",
      "zh": "兵者，詭道也。"
    },
    {
      "id": "1.19",
      "zh": "故能而示之不能，用而示之不用，近而示之遠，遠而示之近。"
    },
    {
      "id": "1.20",
      "zh": "利而誘之，亂而取之，"
    },
    {
      "id": "1.21",
      "zh": "實而備之，強而避之，"
    },
    {
      "id": "1.22",
      "zh": "怒而撓之，卑而驕之，"
    },
    {
      "id": "1.23",
      "zh": "佚而勞之，親而離之，"
    },
    {
      "id": "1.24",
      "zh": "攻其無備，出其不意。"
    },
    {
      "id": "1.25",
      "zh": "此兵家之勝，不可先傳也。"
    },
    {
      "id": "1.26",
      "zh": "夫未戰而廟算勝者，得算多也；未戰而廟算不勝者，得算少也。多算勝，少算不勝，而況無算乎！吾以此觀之，勝負見矣。"
    }
  ]
}
