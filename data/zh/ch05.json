{
  "n": 5,
  "segments": [
    {
      "id": "5.1",
      "zh": "孫子曰：凡治眾如治寡，分數是也；"
    },
    {
      "id": "5.2",
      "zh": "鬥眾如鬥寡，形名是也；"
    },
    {
      "id": "5.3",
      "zh": "三軍之眾，可使必受敵而無敗者，奇正是也；"
    },
    {
      "id": "5.4",
      "zh": "兵之所加，如以碫投卵者，虛實是也。"
    },
    {
      "id": "5.5",
      "zh": "凡戰者，以正合，以奇勝。"
    },
    {
      "id": "5.6",
      "zh": "故善出奇者，無窮如天地，不竭如江海。終而複始，日月是也。死而復生，四時是也。"
    },
    {
      "id": "5.7",
      "zh": "聲不過五，五聲之變，不可勝聽也；"
    },
    {
      "id": "5.8",
      "zh": "色不過五，五色之變，不可勝觀也；"
    },
    {
      "id": "5.9",
      "zh": "味不過五，五味之變，不可勝嘗也；"
    },
    {
      "id": "5.10",
      "zh": "戰勢，不過奇正，奇正之變，不可勝窮也。"
    },
    {
      "id": "5.11",
      "zh": "奇正相生，如循環之無端，熟能窮之哉？"
    },
    {
      "id": "5.12",
      "zh": "激水之疾，至於漂石者，勢也；"
    },
    {
      "id": "5.13",
      "zh": "鷙鳥之疾，至於毀折者，節也。"
    },
    {
      "id": "5.14",
      "zh": "是故善戰者，其勢險，其節短。"
    },
    {
      "id": "5.15",
      "zh": "勢如張弩，節如發機。"
    },
    {
      "id": "5.16",
      "zh": "紛紛紜紜，鬥亂而不可亂也；渾渾沌沌，形圓而不可敗也。"
    },
    {
      "id": "5.17",
      "zh": "亂生於治，怯生於勇，弱生於強。"
    },
    {
      "id": "5.18",
      "zh": "治亂，數也；勇怯，勢也；強弱，形也。"
    },
    {
      "id": "5.19",
      "zh": "故善動敵者，形之，敵必從之；予之，敵必取之。"
    },
    {
      "id": "5.20",
      "zh": "以利動之，以卒待之。"
    },
    {
      "id": "5.21",
      "zh": "故善戰者，求之於勢，不責於人；故能擇人而任勢。"
    },
    {
      "id": "5.22",
      "zh": "任勢者，其戰人也，如轉木石。木石之性，安則靜，危則動，方則止，圓則行。"
    },
    {
      "id": "5.23",
      "zh": "故善戰人之勢，如轉圓石於千仞之山者，勢也。"
    }
  ]
}
